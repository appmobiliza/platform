# ===========================================
# MOBILIZA — Variáveis de Ambiente
# ===========================================
#
# COPIE ESTE ARQUIVO PARA .env E PREENCHA OS VALORES
# NÃO COMMITAR O .env REAL COM CHAVES REAIS
#

# ===========================================
# Database (Neon PostgreSQL)
# ===========================================
# Connection string do Neon - obtenha em https://neon.tech
# Formato: postgresql://usuario:senha@host:5432/dbname
DATABASE_URL=postgresql://usuario:senha@seu-projeto.neon.tech/dbname

# ===========================================
# API Server
# ===========================================
PORT=3001
NODE_ENV=development

# ===========================================
# Better Auth (Google OAuth)
# ===========================================
# GOOGLE_CLIENT_ID e GOOGLE_CLIENT_SECRET:
# Obtidos no Google Cloud Console > APIs e Serviços > Credenciais
# OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID=seu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=seu_google_client_secret_aqui

# BETTER_AUTH_SECRET:
# Gere com: openssl rand -base64 32 (rode isso no terminal meu camarada)
# Mínimo 32 caracteres
BETTER_AUTH_SECRET=gerar_com_openssl_rand_base64_32_caracteres

# ===========================================
# CORS / Origens Confiadas
# ===========================================
# URLs separadas por vírgula (sem espaços)
# Local: http://localhost:3000 (web), http://localhost:3001 (api)
# Production: URLs reais do deploy
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# ===========================================
# Realtime Provider
# ===========================================
# Opções: mock | supabase | websocket | ably | pusher
# mock = sem realtime (para desenvolvimento/testes)
# supabase = usar Supabase Realtime
# websocket = WebSocket server próprio
# ably = Ably Realtime (precisa ABLY_API_KEY)
# pusher = Pusher (precisa credentials)
REALTIME_PROVIDER=mock

# ===========================================
# Supabase (se REALTIME_PROVIDER=supabase)
# ===========================================
# Encontrados em: Supabase Dashboard > Settings > API
SUPABASE_URL=https://seu_projeto.supabase.co
SUPABASE_ANON_KEY=sua_chave_anon_aqui

# ===========================================
# Ably (se REALTIME_PROVIDER=ably)
# ===========================================
# Encontrado em: https://ably.com/dashboard
ABLY_API_KEY=sua_chave_ably_aqui

# ===========================================
# Pusher (se REALTIME_PROVIDER=pusher)
# ===========================================
PUSHER_APP_ID=seu_app_id
PUSHER_KEY=sua_chave
PUSHER_SECRET=seu_secret
PUSHER_CLUSTER=us2

# ===========================================
# WebSocket Server (se REALTIME_PROVIDER=websocket)
# ===========================================
# WS_URL=http://localhost:4001

# ===========================================
# INSTRUÇÕES DE SETUP
# ===========================================
#
# 1. DATABASE_URL:
#    - Crie projeto em https://neon.tech
#    - Vá em Dashboard > Connection Details
#    - Copie a connection string completa
#
# 2. GOOGLE OAuth:
#    - Acesse https://console.cloud.google.com/
#    - Crie projeto ou selecione existente
#    - Vá em APIs e Serviços > Credenciais
#    - Crie OAuth 2.0 Client ID (Web Application)
#    - Adicione URI de redirecionamento:
#      http://localhost:3001/api/auth/callback/google
#    - Copie Client ID e Client Secret
#
# 3. BETTER_AUTH_SECRET:
#    - Terminal: openssl rand -base64 32
#    - Ou online: https://1password.com/password-generator/
#    - Use 32+ caracteres aleatórios
#
# ===========================================
# SEGURANÇA
# ===========================================
# NUNCA commit este arquivo com valores reais
# Use .gitignore para ignorar .env
# Em produção, use variáveis de ambiente do servidor
# ===========================================
