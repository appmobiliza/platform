# Este arquivo é um mapa consolidado das variáveis usadas no monorepo.
# Os exemplos específicos continuam em:
# - apps/api/.env.example
# - packages/auth/.env.example
# - packages/db/.env.example
# - apps/web/.env.example

# ===========================================
# Banco de dados
# ===========================================
# Usado por: apps/api e packages/db
# Formato: postgresql://usuario:senha@host:5432/dbname
DATABASE_URL=postgresql://usuario:senha@seu-projeto.neon.tech/dbname

# ===========================================
# API / Auth
# ===========================================
# Usado por: apps/api e packages/auth
PORT=3001
NODE_ENV=development
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8081
CRON_SECRET=

# Better Auth
BETTER_AUTH_SECRET=gerar_com_openssl_rand_base64_32_caracteres
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth
GOOGLE_CLIENT_ID=seu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=seu_google_client_secret_aqui

# ===========================================
# Realtime
# ===========================================
# Usado por: apps/api e packages/realtime
# Opções: mock | supabase | websocket | ably | pusher
REALTIME_PROVIDER=mock
SUPABASE_URL=https://seu_projeto.supabase.co
SUPABASE_ANON_KEY=sua_chave_anon_aqui
WS_URL=http://localhost:4001
ABLY_API_KEY=sua_chave_ably_aqui
PUSHER_APP_ID=seu_app_id
PUSHER_KEY=sua_chave
PUSHER_SECRET=seu_secret
PUSHER_CLUSTER=us2

# ===========================================
# Web
# ===========================================
# Usado por: apps/web
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:3001
BACKEND_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000