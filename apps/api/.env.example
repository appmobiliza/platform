# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/mobiliza

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Gere um secret forte: openssl rand -base64 32
BETTER_AUTH_SECRET=seu_secret_aqui
BETTER_AUTH_URL=http://localhost:3001

# Origens confiáveis (separadas por vírgula) — frontend Next.js e app mobile
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8081

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Crie em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Realtime ─────────────────────────────────────────────────────────────────
# Valores possíveis: supabase | websocket | ably | pusher | mock
REALTIME_PROVIDER=supabase

# Supabase (provider padrão para desenvolvimento e apresentação)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# WebSocket (para produção com infra própria do NAC)
# WS_URL=ws://0.0.0.0:4001

# Ably (alternativa gerenciada)
# ABLY_API_KEY=xVLyHw.xxxxxxxx:yyyyyy

# Pusher (alternativa com free tier generoso)
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=us2
