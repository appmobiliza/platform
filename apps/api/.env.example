# Este arquivo alimenta a execução de apps/api.
# A API importa também os blocos de auth, db e realtime do pacote @mobiliza/env.

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8081
# Opcional: protege endpoints de cron quando definido
CRON_SECRET=

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Obrigatório para subir a API localmente, porque apps/api inicializa o handler de auth.
# Gere um secret forte com algo como: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Credenciais OAuth do Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/mobiliza

# ─── Realtime ─────────────────────────────────────────────────────────────────
# Valores possíveis: supabase | websocket | ably | pusher | mock
REALTIME_PROVIDER=supabase

# Ably
ABLY_API_KEY=xVLyHw.xxxxxxxx:yyyyyy