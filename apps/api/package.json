{
  "name": "@mobiliza/api",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor HTTP do Mobiliza — Hono + tRPC + Better Auth",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && tsup src/index.ts --format esm --target node20",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@mobiliza/db": "workspace:*",
    "@mobiliza/realtime": "workspace:*",
    "@supabase/supabase-js": "^2.106.0",
    "@trpc/server": "^11.17.0",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.19",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mobiliza/typescript-config": "workspace:*",
    "@types/node": "^25.9.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.2"
  }
}