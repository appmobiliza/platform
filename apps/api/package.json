{
	"name": "@mobiliza/api",
	"version": "0.1.0",
	"private": true,
	"description": "Servidor HTTP do Mobiliza — Hono + tRPC + Better Auth",
	"type": "module",
	"main": "./src/index.ts",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc --noEmit && tsup src/index.ts --format esm --target node20",
		"start": "node dist/index.js",
		"check-types": "tsc --noEmit",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"check-infra": "tsx scripts/check-infra.ts"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.14",
		"@hono/trpc-server": "^0.4.2",
		"@mobiliza/contracts": "workspace:*",
		"@mobiliza/db": "workspace:*",
		"@mobiliza/domain": "workspace:*",
		"@mobiliza/realtime": "workspace:*",
		"hono": "^4.12.19",
		"trpc-to-openapi": "^3.3.0",
		"uuidv7": "^1.2.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@jest/globals": "29.7.0",
		"@mobiliza/typescript-config": "workspace:*",
		"@trpc/server": "^11.17.0",
		"@types/jest": "29.5.14",
		"@types/node": "^25.9.0",
		"dotenv": "^17.4.2",
		"jest": "29.7.0",
		"ts-jest": "29.4.11",
		"tsup": "^8.5.1",
		"tsx": "^4.22.2"
	}
}
