{
	"name": "@mobiliza/api",
	"version": "0.1.0",
	"private": true,
	"description": "Servidor HTTP do Mobiliza — Hono + tRPC + Better Auth",
	"type": "module",
	"exports": {
		"./router": {
			"types": "./src/router.ts",
			"default": "./dist/router.js"
		}
	},
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc --noEmit && tsup src/server.ts src/router.ts --format esm --target node20 --dts",
		"start": "node dist/server.js",
		"check-types": "tsc --noEmit",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest",
		"test:coverage": "jest --coverage",
		"check-infra": "tsx scripts/check-infra.ts"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.14",
		"@hono/trpc-server": "^0.4.2",
		"@mobiliza/auth": "workspace:*",
		"@mobiliza/contracts": "workspace:*",
		"@mobiliza/db": "workspace:*",
		"@mobiliza/domain": "workspace:*",
		"@mobiliza/env": "workspace:*",
		"@mobiliza/realtime": "workspace:*",
		"@mobiliza/trpc": "workspace:*",
		"dotenv": "^17.4.2",
		"hono": "^4.12.19",
		"uuidv7": "^1.2.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@mobiliza/typescript-config": "workspace:*",
		"@jest/globals": "29.7.0",
		"@trpc/server": "^11.17.0",
		"@types/jest": "29.5.14",
		"@types/node": "^25.9.0",
		"jest": "29.7.0",
		"ts-jest": "29.4.11",
		"tsup": "^8.5.1",
		"tsx": "^4.22.4"
	}
}
