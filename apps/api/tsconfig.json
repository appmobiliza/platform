{
	"extends": "@mobiliza/typescript-config/base.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"paths": {
			"@/*": ["./src/*"]
		},
		"types": ["node", "jest"]
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
