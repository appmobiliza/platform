{
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"paths": {
			"@/*": ["./src/*"]
		},
		"types": ["node", "jest"],
		"strictNullChecks": true,
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"module": "ESNext",
		"ignoreDeprecations": "6.0"
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
