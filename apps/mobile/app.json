{
	"expo": {
		"name": "Mobiliza",
		"slug": "mobiliza",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "mobiliza",
		"userInterfaceStyle": "automatic",
		"ios": {
			"icon": {
				"dark": "./assets/images/ios/ios-dark.png",
				"light": "./assets/images/ios/ios-light.png",
				"tinted": "./assets/images/ios/ios-tinted.png"
			}
		},
		"android": {
			"icon": "./assets/images/icon.png",
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/images/android/adaptive-icon.png",
				"backgroundImage": "./assets/images/android/background.png",
				"monochromeImage": "./assets/images/android/adaptive-icon.png"
			},
			"predictiveBackGestureEnabled": false,
			"softwareKeyboardLayoutMode": "pan",
			"package": "br.ufal.mobiliza"
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-speech-recognition",
			"expo-font",
			[
				"expo-router",
				{
					"headers": {
						"Cross-Origin-Embedder-Policy": "credentialless",
						"Cross-Origin-Opener-Policy": "same-origin"
					}
				}
			],
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#005E65",
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 1024
				}
			],
			[
				"expo-status-bar",
				{
					"hidden": false,
					"style": "light"
				}
			],
			[
				"expo-navigation-bar",
				{
					"enforceContrast": false,
					"hidden": false,
					"style": "light"
				}
			],
			"expo-image",
			"expo-web-browser",
			"@maplibre/maplibre-react-native",
			"expo-secure-store",
			"expo-sqlite"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true,
			"tsconfigPaths": true
		},
		"extra": {
			"router": {},
			"expo-status-bar": {
				"style": "light",
				"hidden": false
			},
			"expo-navigation-bar": {
				"enforceContrast": false,
				"style": "light",
				"hidden": false
			},
			"eas": {
				"projectId": "f0188ce7-a169-49f9-826a-288dd1010ad3"
			}
		}
	}
}
