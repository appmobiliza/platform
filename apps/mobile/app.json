{
	"expo": {
		"name": "Mobiliza",
		"slug": "mobiliza",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "mobiliza",
		"userInterfaceStyle": "automatic",
		"ios": {
			"icon": {
				"dark": "./assets/images/ios/ios-dark.png",
				"light": "./assets/images/ios/ios-light.png",
				"tinted": "./assets/images/ios/ios-tinted.png"
			}
		},
		"android": {
			"icon": "./assets/images/icon.png",
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/images/android/adaptive-icon.png",
				"backgroundImage": "./assets/images/android/background.png",
				"monochromeImage": "./assets/images/android/adaptive-icon.png"
			},
			"predictiveBackGestureEnabled": false,
			"softwareKeyboardLayoutMode": "pan",
			"package": "br.ufal.mobiliza"
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#005E65",
					"android": {
						"image": "./assets/images/splash-icon.png",
						"imageWidth": 40
					}
				}
			],
			[
				"expo-status-bar",
				{
					"hidden": false,
					"style": "light"
				}
			],
			[
				"expo-navigation-bar",
				{
					"enforceContrast": false,
					"hidden": false,
					"style": "light"
				}
			],
			[
				"expo-font",
				{
					"android": {
						"fonts": [
							{
								"fontFamily": "Atkinson Hyperlegible Next",
								"fontDefinitions": [
									{
										"path": "./node_modules/@expo-google-fonts/atkinson-hyperlegible-next/200ExtraLight/AtkinsonHyperlegibleNext_200ExtraLight.ttf",
										"weight": 200
									},
									{
										"path": "./node_modules/@expo-google-fonts/atkinson-hyperlegible-next/200ExtraLight_Italic/AtkinsonHyperlegibleNext_200ExtraLight_Italic.ttf",
										"weight": 200,
										"style": "italic"
									},
									{
										"path": "./node_modules/@expo-google-fonts/atkinson-hyperlegible-next/300Light/AtkinsonHyperlegibleNext_300Light.ttf",
										"weight": 300
									},
									{
										"path": "./node_modules/@expo-google-fonts/atkinson-hyperlegible-next/300Light_Italic/AtkinsonHyperlegibleNext_300Light_Italic.ttf",
										"weight": 300,
										"style": "italic"
									},
									{
										"path": "./node_modules/@expo-google-fonts/atkinson-hyperlegible-next/400Regular/AtkinsonHyperlegibleNext_400Regular.ttf",
										"weight": 400
									},
									{
										"path": "./node_modules/@expo-google-fonts/atkinson-hyperlegible-next/400Regular_Italic/AtkinsonHyperlegibleNext_400Regular_Italic.ttf",
										"weight": 400,
										"style": "italic"
									},
									{
										"path": "./node_modules/@expo-google-fonts/atkinson-hyperlegible-next/500Medium/AtkinsonHyperlegibleNext_500Medium.ttf",
										"weight": 500
									},
									{
										"path": "./node_modules/@expo-google-fonts/atkinson-hyperlegible-next/500Medium_Italic/AtkinsonHyperlegibleNext_500Medium_Italic.ttf",
										"weight": 500,
										"style": "italic"
									},
									{
										"path": "./node_modules/@expo-google-fonts/atkinson-hyperlegible-next/600SemiBold/AtkinsonHyperlegibleNext_600SemiBold.ttf",
										"weight": 600
									},
									{
										"path": "./node_modules/@expo-google-fonts/atkinson-hyperlegible-next/600SemiBold_Italic/AtkinsonHyperlegibleNext_600SemiBold_Italic.ttf",
										"weight": 600,
										"style": "italic"
									},
									{
										"path": "./node_modules/@expo-google-fonts/atkinson-hyperlegible-next/700Bold/AtkinsonHyperlegibleNext_700Bold.ttf",
										"weight": 700
									},
									{
										"path": "./node_modules/@expo-google-fonts/atkinson-hyperlegible-next/700Bold_Italic/AtkinsonHyperlegibleNext_700Bold_Italic.ttf",
										"weight": 700,
										"style": "italic"
									},
									{
										"path": "./node_modules/@expo-google-fonts/atkinson-hyperlegible-next/800ExtraBold/AtkinsonHyperlegibleNext_800ExtraBold.ttf",
										"weight": 800
									},
									{
										"path": "./node_modules/@expo-google-fonts/atkinson-hyperlegible-next/800ExtraBold_Italic/AtkinsonHyperlegibleNext_800ExtraBold_Italic.ttf",
										"weight": 800,
										"style": "italic"
									}
								]
							},
							{
								"fontFamily": "Google Sans Flex",
								"fontDefinitions": [
									{
										"path": "./node_modules/@expo-google-fonts/google-sans-flex/100Thin/GoogleSansFlex_100Thin.ttf",
										"weight": 100
									},
									{
										"path": "./node_modules/@expo-google-fonts/google-sans-flex/200ExtraLight/GoogleSansFlex_200ExtraLight.ttf",
										"weight": 200
									},
									{
										"path": "./node_modules/@expo-google-fonts/google-sans-flex/300Light/GoogleSansFlex_300Light.ttf",
										"weight": 300
									},
									{
										"path": "./node_modules/@expo-google-fonts/google-sans-flex/400Regular/GoogleSansFlex_400Regular.ttf",
										"weight": 400
									},
									{
										"path": "./node_modules/@expo-google-fonts/google-sans-flex/500Medium/GoogleSansFlex_500Medium.ttf",
										"weight": 500
									},
									{
										"path": "./node_modules/@expo-google-fonts/google-sans-flex/600SemiBold/GoogleSansFlex_600SemiBold.ttf",
										"weight": 600
									},
									{
										"path": "./node_modules/@expo-google-fonts/google-sans-flex/700Bold/GoogleSansFlex_700Bold.ttf",
										"weight": 700
									},
									{
										"path": "./node_modules/@expo-google-fonts/google-sans-flex/800ExtraBold/GoogleSansFlex_800ExtraBold.ttf",
										"weight": 800
									},
									{
										"path": "./node_modules/@expo-google-fonts/google-sans-flex/900Black/GoogleSansFlex_900Black.ttf",
										"weight": 900
									}
								]
							}
						]
					}
				}
			],
			"expo-image",
			"expo-web-browser",
			"@maplibre/maplibre-react-native",
			"expo-secure-store"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true,
			"tsconfigPaths": true
		},
		"extra": {
			"router": {},
			"expo-status-bar": {
				"style": "light",
				"hidden": false
			},
			"expo-navigation-bar": {
				"enforceContrast": false,
				"style": "light",
				"hidden": false
			},
			"eas": {
				"projectId": "f0188ce7-a169-49f9-826a-288dd1010ad3"
			}
		}
	}
}
