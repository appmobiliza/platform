{
	"name": "@mobiliza/auth",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"scripts": {
		"build": "tsup src/index.ts src/proxy.ts src/server.ts --format esm --dts --no-splitting --target node20 --out-dir dist && tsup src/client.ts --format esm --no-splitting --target node20 --out-dir dist"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./proxy": {
			"types": "./src/proxy.ts",
			"default": "./dist/proxy.js"
		},
		"./client": {
			"types": "./src/client.ts",
			"default": "./dist/client.js"
		},
		"./server": {
			"types": "./src/server.ts",
			"default": "./dist/server.js"
		}
	},
	"dependencies": {
		"@mobiliza/contracts": "workspace:*",
		"@mobiliza/db": "workspace:*",
		"@mobiliza/env": "workspace:*",
		"better-auth": "1.6.11",
		"@better-auth/expo": "1.6.11"
	},
	"devDependencies": {
		"@mobiliza/typescript-config": "workspace:*"
	}
}
