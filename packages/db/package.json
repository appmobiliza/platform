{
	"name": "@mobiliza/db",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./src/client.ts",
			"default": "./dist/client.js"
		},
		"./drizzle": {
			"types": "./src/drizzle.ts",
			"default": "./dist/drizzle.js"
		},
		"./schema": {
			"types": "./src/schema/index.ts",
			"default": "./dist/schema/index.js"
		}
	},
	"scripts": {
		"build": "tsup src/index.ts src/client.ts src/drizzle.ts src/schema/index.ts --format esm --dts --no-splitting --target node20 --out-dir dist",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@mobiliza/contracts": "workspace:*",
		"@mobiliza/env": "workspace:*",
		"@neondatabase/serverless": "^1.1.0",
		"drizzle-orm": "^0.45.2"
	},
	"devDependencies": {
		"@mobiliza/typescript-config": "workspace:*",
		"drizzle-kit": "^0.31.10"
	}
}
