		"uuidv7": "^1.2.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@mobiliza/typescript-config": "workspace:*",
		"@types/node": "^25.9.1",
		"typescript": "^6.0.3"
	}
}
