{
	"name": "@mobiliza/env",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsup src/shared.ts src/api.ts src/auth.ts src/base-url.ts src/realtime.ts --format esm --dts --no-splitting --target node20 --out-dir dist"
	},
	"exports": {
		"./api": {
			"types": "./dist/api.d.ts",
			"default": "./dist/api.js"
		},
		"./auth": {
			"types": "./dist/auth.d.ts",
			"default": "./dist/auth.js"
		},
		"./realtime": {
			"types": "./dist/realtime.d.ts",
			"default": "./dist/realtime.js"
		},
		"./shared": {
			"types": "./dist/shared.d.ts",
			"default": "./dist/shared.js"
		},
		"./base-url": {
			"types": "./dist/base-url.d.ts",
			"default": "./dist/base-url.js"
		}
	},
	"dependencies": {
		"@t3-oss/env-core": "^0.13.8",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@mobiliza/typescript-config": "workspace:*",
		"@types/node": "^25.8.0",
		"dotenv": "^17.4.2"
	}
}
