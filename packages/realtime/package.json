{
	"name": "@mobiliza/realtime",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"react-native": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./src/client.ts",
			"react-native": "./src/client.ts",
			"default": "./dist/client.js"
		},
		"./types": {
			"types": "./src/types.ts",
			"react-native": "./src/types.ts",
			"default": "./dist/types.js"
		}
	},
	"scripts": {
		"build": "tsup src/index.ts src/types.ts src/client.ts --format esm --dts --no-splitting --target node20 --out-dir dist",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"test": "jest"
	},
	"devDependencies": {
		"@jest/globals": "^29.7.0",
		"@mobiliza/typescript-config": "workspace:*",
		"@types/jest": "^29.5.0",
		"@types/node": "^25.8.0",
		"@types/ws": "^8.18.1",
		"jest": "^29.7.0",
		"ts-jest": "^29.4.11"
	},
	"dependencies": {
		"@mobiliza/env": "workspace:*",
		"@supabase/supabase-js": "^2.106.0",
		"ably": "^2.21.0",
		"pusher": "^5.3.3",
		"ws": "^8.21.0"
	}
}
