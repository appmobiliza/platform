{
	"name": "@mobiliza/trpc-types",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --no-splitting --out-dir dist",
		"check-types": "tsc --noEmit"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"dependencies": {
		"@trpc/server": "^11.17.0"
	},
	"devDependencies": {
		"@mobiliza/api": "workspace:*",
		"@mobiliza/typescript-config": "workspace:*",
		"typescript": "^6.0.3"
	}
}
