{
	"name": "@mobiliza/trpc",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup src/index.ts src/context.ts src/errors.ts --format esm --dts --no-splitting --target node20 --out-dir dist"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./context": {
			"types": "./dist/context.d.ts",
			"default": "./dist/context.js"
		},
		"./errors": {
			"types": "./dist/errors.d.ts",
			"default": "./dist/errors.js"
		}
	},
	"dependencies": {
		"@mobiliza/domain": "workspace:*",
		"@mobiliza/realtime": "workspace:*",
		"@trpc/server": "^11.17.0"
	},
	"devDependencies": {
		"@types/node": "^25.9.0"
	}
}
